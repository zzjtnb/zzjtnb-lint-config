{
  "name": "@zzjtnb/lint-demo",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.ts --fix --cache --cache-location node_modules/.cache/.stylelintcache",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@zzjtnb/eslint-config": "workspace:*",
    "@zzjtnb/stylelint-config": "workspace:*",
    "eslint": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:"
  }
}
