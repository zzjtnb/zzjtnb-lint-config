{
  "name": "@zzjtnb/lint-demo",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.js --fix --cache --cache-location node_modules/.cache/.stylelintcache",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "eslint-config-zzjtnb": "workspace:*",
    "stylelint": "^17.12.0",
    "stylelint-config-zzjtnb": "workspace:*",
    "typescript": "6.0.3"
  }
}
