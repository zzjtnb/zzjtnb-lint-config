// markdownlint-cli2 配置文件
// https://github.com/DavidAnson/markdownlint-cli2
// 检查: markdownlint-cli2 "**/*.md"
// 修复: markdownlint-cli2 --fix "**/*.md"
//
// ⚠️ 重要：markdownlint-cli2 不会自动排除 node_modules
// 必须通过以下方式之一显式配置：
// 1. 配置文件：ignores: ["node_modules/**"]（推荐）
// 2. 命令行：markdownlint-cli2 "**/*.md" "#node_modules"
{
  // 自动读取 .gitignore 文件（补充 ignores 配置，不能替代）
  "gitignore": true,
  // 通用忽略项需与 ESLint / Stylelint 默认忽略保持同一份语义；
  // 仓库专属忽略项只保留在本地配置中。
  // （markdownlint-cli2 不会自动忽略任何目录，必须显式配置）。
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.nuxt/**",
    "**/.turbo/**",
    "**/.vercel/**",
    "**/.wrangler/**",
    "**/coverage/**",
    "**/backup/**",
    "**/releases/**",
    "**/src-tauri/**",
    "**/stats.html",
    "**/twa/project/**"
  ],
  // 规则统一由共享包维护；本文件只保留仓库的执行范围。
  "config": {
    "extends": "./packages/markdownlint-config/index.jsonc"
  }
}
