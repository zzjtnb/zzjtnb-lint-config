{
  // "http.proxy": "http://127.0.0.1:10808",
  // "http.proxyStrictSSL": false,
  // "http.proxySupport": "on",
  // 集成终端设置
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.stickyScroll.enabled": true,
  "npm.packageManager": "pnpm",
  // 使用仓库根目录安装的 TypeScript，避免编辑器与 vue-tsc 使用不同版本
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "svg.preview.background": "transparent",
  "html.autoClosingTags": false,
  "prettier.enable": false,
  "editor.formatOnSave": false, // 关闭全局保存格式化，避免和 ESLint/Stylelint 冲突
  // 保存时自动修复 ESLint、Stylelint 和 Markdownlint 问题
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.fixAll.stylelint": "explicit",
    // Markdown 在显式保存和自动保存时均修复，规则读取项目的 CLI2 配置。
    "source.fixAll.markdownlint": "always",
    "source.organizeImports": "never"
  },
  // 关闭内置校验,仅用 stylelint 检查
  "scss.validate": false,
  "css.validate": false,
  "less.validate": false,
  "stylelint.packageManager": "pnpm",
  // 指定要验证的文件
  "stylelint.validate": [
    "css",
    "scss",
    "vue",
    "html"
  ],
  // 隐藏编辑器中的样式规则诊断，仍允许自动修复
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "format/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-indent",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spacing",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spaces",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-order",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-dangle",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-newline",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*quotes",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*semi",
      "severity": "off",
      "fixable": true
    }
  ],
  // 为以下受支持的语言启用 ESLint 检查
  "eslint.validate": [
    "javascript",
    "typescript",
    "vue",
    "html",
    "json",
    "jsonc",
    "yaml",
    "toml"
  ],
  // Markdown 的规则来自项目配置，不在编辑器设置中重复维护。
  "[markdown]": {
    // 手动格式化和粘贴格式化使用 Markdownlint。
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
    // 保存已由 fixAll 处理，关闭重复的保存格式化路径。
    "editor.formatOnSave": false,
    "editor.formatOnPaste": true
  },
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[scss]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[toml]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "files.associations": {
    "*.css": "tailwindcss",
    "*.ejs": "html",
    "*.art": "html",
    "*.tpl": "html",
    "**/tsconfig.json": "jsonc",
    "*.json": "jsonc",
    "package.json": "json"
  },
  "cSpell.words": [
    "lucide",
    "zzjtnb"
  ]
}
