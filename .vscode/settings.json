{
  // "http.proxy": "http://127.0.0.1:10808",
  // "http.proxyStrictSSL": false,
  // "http.proxySupport": "on",
  // 文件关联：将 .tpl 文件识别为 HTML
  "files.associations": {
    "*.tpl": "html"
  },
  "js/ts.tsdk.path": "./node_modules/typescript/lib",
  "npm.packageManager": "pnpm",
  // 指定项目本地安装的TypeScript版本路径，让VSCode使用项目的TS而非内置版本
  // "typescript.tsdk": "./node_modules/typescript/lib",
  // 自动使用工作区的TypeScript版本，不再弹出选择提示
  // "typescript.enablePromptUseWorkspaceTsdk": false,
  // 启用项目级诊断功能，使编辑器能提供与命令行pnpm type-check相同的类型检查
  // "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  // Disable the default formatter, use eslint instead
  "svg.preview.background": "black",
  "html.autoClosingTags": false,
  "prettier.enable": false,
  "editor.formatOnSave": false, // 关闭全局保存格式化，避免和 ESLint/Stylelint 冲突
  // Auto fix
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always",
    "source.fixAll.stylelint": "always",
    "source.organizeImports": "never"
  },
  // 关闭内置校验,仅用 stylelint 检查
  "scss.validate": false,
  "css.validate": false,
  "less.validate": false,
  "stylelint.packageManager": "pnpm",
  // 指定要验证的文件
  "stylelint.validate": [
    "css",
    "scss",
    "vue",
    "html"
  ],
  // Silent the stylistic rules in you IDE, but still auto fix them
  "eslint.rules.customizations": [
    {
      "rule": "style/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "format/*",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-indent",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spacing",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-spaces",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-order",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-dangle",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*-newline",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*quotes",
      "severity": "off",
      "fixable": true
    },
    {
      "rule": "*semi",
      "severity": "off",
      "fixable": true
    }
  ],
  // Enable eslint for all supported languages
  "eslint.validate": [
    "javascript",
    "typescript",
    "vue",
    "html",
    "json",
    "jsonc",
    "yaml",
    "toml"
  ],
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[scss]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[toml]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  // ========================== 搜索忽略 ==========================
  "search.exclude": {
    "**/.git": true,
    "**/*.svg": true,
    "**/dist/**": true,
    "**/.vscode": true,
    "**/node_modules": true,
    "**/.pnpm": true,
    "**/.yarn": true,
    "**/yarn.lock": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true
  },
  // ========== 文件嵌套 ==========
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.dart": "${capture}.g.dart",
    "*.css": "$(capture).css.map, $(capture).*.css",
    "*.js": "$(capture).js.map, $(capture).*.js, $(capture)_*.js",
    "*.ts": "$(capture).js, $(capture).d.ts.map, $(capture).*.ts, $(capture)_*.js, $(capture)_*.ts",
    "*.mjs": "$(capture).mjs.map, $(capture).*.mjs, $(capture)_*.mjs",
    "*.cjs": "$(capture).cjs.map, $(capture).*.cjs, $(capture)_*.cjs",
    "*.vue": "$(capture).*.ts, $(capture).*.js, $(capture).story.vue",
    ".env": "*.env, .env.*, .envrc, env.d.ts",
    ".gitignore": ".gitattributes, .gitmodules, .gitmessage, .mailmap, .git-blame*",
    "dockerfile": ".dockerignore, docker-compose.*, dockerfile*",
    "shims.d.ts": "*.d.ts",
    "vite.config.*": "*.env, .babelrc*, .env.*, babel.config.*, env.d.ts, jsconfig.*,  playwright.config.*, postcss.config.*, vitest.config.*, webpack.config.* ",
    "vue.config.*": "*.env, .babelrc*, .env.*, babel.config.*, env.d.ts, jsconfig.*,  playwright.config.*, postcss.config.*, tailwind.config.*, vitest.config.*, webpack.config.*",
    "nuxt.config.*": "*.env, .babelrc*, .env.*, env.d.ts, jsconfig.*, playwright.config.*, postcss.config.*, tailwind.config.*, vitest.config.*",
    "package.json": ".browserslist*, .commitlint*, .cz-config.js, .editorconfig, .eslint*, .github*, .nodemon*, .npm*, .nvmrc, .pm2*, .pnpm*, .prettier*, .vscode*, .yamllint*, .yarnrc*, gulp*, lint-staged*,package-lock.json, pm2.*, pnpm*, prettier*, stylelint*, eslint*, typedoc*, webpack*, workspace.json, yarn*,package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .prettier*, prettier*, .editorconfig, .markdownlint-cli2.*, components.json",
    "pubspec.yaml": ".metadata, .packages, all_lint_rules.yaml, analysis_options.yaml, build.yaml, pubspec.lock, pubspec_overrides.yaml",
    "README.md": "README.zh-CN.md, CHANGELOG.md, CONTRIBUTING.md, SECURITY.md, CODE_OF_CONDUCT.md",
    "LICENSE": "LICENSE.*",
    "eslint.config.js": ".eslint*, eslint.config.cjs, eslint.config.mjs, eslint.config.ts",
    "stylelint.config.js": ".stylelint*, stylelint.config.cjs, stylelint.config.mjs, stylelint.config.ts",
    "tsconfig.json": "tsconfig.*.json, jsconfig.json, jsconfig.*.json",
    "pnpm-workspace.yaml": "pnpm-lock.yaml, pnpmfile.*, .npmrc",
    "turbo.json": "turbo.*",
    "unocss.config.js": "uno.config.*, unocss.config.cjs, unocss.config.mjs, unocss.config.ts, uno.css, uno.generated.*"
  },
  "cSpell.words": [
    "lucide",
    "zzjtnb"
  ]
}
