{
  // 关于 tasks.json 格式文档，请参阅：https://go.microsoft.com/fwlink/?LinkId=733558
  "version": "2.0.0",
  "tasks": [
    {
      "label": "typecheck:vendor",
      "type": "process",
      "command": "pnpm",
      "args": [
        "--filter",
        "@jszn/web-vendor",
        "exec",
        "vue-tsc",
        "--noEmit",
        "--skipLibCheck",
        "--watch",
        "--pretty",
        "false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vue-tsc-vendor",
        "fileLocation": ["relative", "${workspaceFolder}/apps/web-vendor"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (TS\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "typecheck:dealer",
      "type": "process",
      "command": "pnpm",
      "args": [
        "--filter",
        "@jszn/web-dealer",
        "exec",
        "vue-tsc",
        "--noEmit",
        "--skipLibCheck",
        "--watch",
        "--pretty",
        "false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vue-tsc-dealer",
        "fileLocation": ["relative", "${workspaceFolder}/apps/web-dealer"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (TS\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "typecheck:playground",
      "type": "process",
      "command": "pnpm",
      "args": [
        "--filter",
        "@jszn/playground",
        "exec",
        "vue-tsc",
        "--noEmit",
        "--skipLibCheck",
        "--watch",
        "--pretty",
        "false"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vue-tsc-playground",
        "fileLocation": ["relative", "${workspaceFolder}/playground"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+),(\\d+)\\): error (TS\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "code": 4,
          "message": 5
        }
      }
    },
    {
      "label": "typecheck:all",
      "dependsOn": [
        "typecheck:vendor",
        "typecheck:dealer",
        "typecheck:playground"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "ui:dev",
      "type": "shell",
      // `dev` keeps running in the background
      // ideally you should also configure a `problemMatcher`
      // see https://code.visualstudio.com/docs/editor/tasks#_can-a-background-task-be-used-as-a-prelaunchtask
      "isBackground": true,
      // change this to your `beforeDevCommand`:
      "command": "pnpm",
      "args": ["dev"]
    },
    {
      "label": "ui:build",
      "type": "shell",
      // change this to your `beforeBuildCommand`:
      "command": "pnpm",
      "args": ["build"]
    }
  ]
}
