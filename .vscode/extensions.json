    "Lokalise.i18n-ally",
    // CSS 变量提示
    "vunguyentuan.vscode-css-variables",
    // 在 package.json 中显示 pnpm catalog 依赖版本
    "antfu.pnpm-catalog-lens",
    // Vitest 测试发现与运行
    "vitest.explorer",
    // shadcn-vue 组件辅助
    "Selemondev.shadcn-vue",
    // Tauri 配置与开发支持
    "tauri-apps.tauri-vscode",
