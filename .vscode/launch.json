{
  // "$schema": "https://json.schemastore.org/launchsettings.json",
  // 使用 VS Code 内置的调试配置 Schema。
  "$schema": "vscode://schemas/launch",
  // 选择下方配置后按 F5，启动对应开发服务，并在服务就绪后打开 Chrome 调试。
  "version": "0.2.0",
  "configurations": [
    {
      // 运行 Playground 子包的 dev 脚本，检查示例页面及 Vue 组件的浏览器行为。
      "name": "调试 Playground",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @zzjtnb/playground dev",
      "cwd": "${workspaceFolder}",
      // Playground 的 dev 脚本带有 --open，由调试器统一打开浏览器，避免重复窗口。
      "env": {
        "BROWSER": "none"
      },
      "serverReadyAction": {
        "action": "debugWithChrome",
        // 使用服务输出的实际地址，端口由 playground/vite.config.ts 固定为 3001。
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/playground",
        "killOnServerStop": true
      }
    },
    {
      // 运行 docs 子包的 dev 脚本，调试 VitePress 文档站。
      "name": "调试文档站",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm --filter @zzjtnb/docs dev",
      "cwd": "${workspaceFolder}",
      "env": {
        "BROWSER": "none"
      },
      "serverReadyAction": {
        "action": "debugWithChrome",
        // 端口由 docs/.vitepress/config.ts 固定为 3000。
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}/docs",
        "killOnServerStop": true
      }
    }
  ],
  "compounds": [
    {
      // 同时启动两个调试入口，停止组合调试时一并停止。
      "name": "同时调试 Playground 与文档站",
      "configurations": [
        "调试 Playground",
        "调试文档站"
      ],
      "stopAll": true
    }
  ]
}
