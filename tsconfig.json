{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "useDefineForClassFields": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@zzjtnb/eslint-config": ["./packages/eslint-config/src/index.ts"],
      "@zzjtnb/stylelint-config": ["./packages/stylelint-config/src/index.ts"]
    },

    "resolveJsonModule": true,

    // 类型声明相关配置
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    // 严格性和类型检查相关配置
    "strict": true,
    "noEmit": true,

    // 调试和兼容性相关配置
    "sourceMap": true,
    // 模块和兼容性相关配置
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },

  "include": [
    "types/**/*.d.ts",
    "mock/**/*.ts",
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "eslint.config.ts",
    "uno.config.ts",
    "packages/eslint-config/src/**/*.ts",
    "packages/stylelint-config/src/**/*.ts",
    "tests/integration/load-configs.js"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
