{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "paths": {
      "@zzjtnb/eslint-config": ["./packages/eslint-config/src/index.ts"],
      "@zzjtnb/stylelint-config": ["./packages/stylelint-config/src/index.ts"]
    },

    "resolveJsonModule": true,

    // 类型声明相关配置
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    // CLI2 转发模块未发布独立声明，读取一层官方 JSDoc 以复用 Markdownlint 类型。
    "maxNodeModuleJsDepth": 1,
    // 严格性和类型检查相关配置
    "strict": true,
    "noEmit": true,

    // 模块和兼容性相关配置
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },

  "include": [
    "eslint.config.ts",
    "stylelint.config.ts",
    "vitest.config.ts",
    "packages/eslint-config/src/**/*.ts",
    "packages/stylelint-config/src/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/fixtures/eslint/**/*.ts",
    "tests/fixtures/markdownlint/no-todo.js"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
