{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "**/.env.*local",
    "**/tsconfig*.json",
    "**/tsdown.config.ts",
    "**/eslint.config.ts",
    "**/stylelint.config.ts"
  ],
  "globalEnv": ["NODE_ENV"],
  // "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "//#lint:eslint": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "//#lint:stylelint": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": []
    },
    "//#lint:markdownlint": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "cache": false,
      "outputs": []
    },
    "lint:eslint": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "outputs": []
    },
    "lint:stylelint": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "lint:markdownlint": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tsconfig.json"],
      "outputs": []
    },
    "version:patch": {
      "cache": false,
      "outputs": []
    },
    "version:minor": {
      "cache": false,
      "outputs": []
    },
    "version:major": {
      "cache": false,
      "outputs": []
    },
    "release:pack": {
      "cache": false,
      "outputs": []
    },
    "release:publish": {
      "cache": false,
      "outputs": []
    },
    "release:verify": {
      "cache": false,
      "outputs": []
    }
  }
}
