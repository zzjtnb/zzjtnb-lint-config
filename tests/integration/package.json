{
  "name": "@zzjtnb/lint-config-integration-tests",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "test": "node load-configs.js",
    "typecheck": "tsc -p ../../tsconfig.json"
