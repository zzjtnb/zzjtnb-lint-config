// Markdownlint 共享规则，使用 JSONC 保留维护注释。
// 配置格式与继承：https://github.com/DavidAnson/markdownlint/blob/v0.42.0/README.md#configuration
{
  // 未列出的规则沿用 Markdownlint 原生默认启用状态，只声明本包差异。
  // MD001：标题层级递增；false 允许跳级，兼容独立文档片段和生成内容。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md001.md
  "MD001": false,

  // MD003：标题风格；style 为 atx 时统一使用 # 开头的标题。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md003.md
  "MD003": {
    // 所有标题统一使用 # 前缀的 ATX 写法，不使用 Setext 下划线标题。
    "style": "atx"
  },

  // MD013：行长度；false 不限制长行，避免拆分长链接、接口说明和模型文档。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md013.md
  "MD013": false,

  // MD024：重复标题；siblings_only 为 true 时只检查同父级标题，跨章节可复用小节名。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md024.md
  "MD024": {
    // 仅在同一父级下检查重复标题，允许不同章节各自使用相同小标题。
    "siblings_only": true
  },

  // MD033：内联 HTML；false 允许全部标签，项目可覆盖 allowed_elements 限制为指定标签。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md033.md
  "MD033": false,

  // MD041：首个内容行必须是顶级标题；false 允许以正文或其他层级的标题开头。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md041.md
  "MD041": false,

  // MD059：链接文本应有描述性；false 保留 here 等既有文案，不进行该项检查。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md059.md
  "MD059": false,

  // MD060：表格列的排版风格；false 不强制视觉对齐，其他默认规则继续检查表格语法。
  // https://github.com/DavidAnson/markdownlint/blob/v0.42.0/doc/md060.md
  "MD060": false
}
