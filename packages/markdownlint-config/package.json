{
  "name": "@zzjtnb/markdownlint-config",
  "version": "1.0.5",
  "description": "面向项目文档的共享 Markdownlint 规则配置。",
  "author": "zzjtnb(https://github.com/zzjtnb)",
  "license": "MIT",
  "homepage": "https://github.com/zzjtnb/zzjtnb-lint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzjtnb/zzjtnb-lint-config.git",
    "directory": "packages/markdownlint-config"
  },
  "bugs": {
    "url": "https://github.com/zzjtnb/zzjtnb-lint-config/issues"
  },
  "keywords": [
    "markdown",
    "markdownlint",
    "markdownlint-config",
    "markdownlint-cli2"
  ],
  "exports": {
    ".": "./index.jsonc"
  },
  "main": "./index.jsonc",
  "files": [
    "README.md",
    "README.zh-CN.md",
    "index.jsonc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint:eslint": "eslint . --max-warnings 0",
    "format": "pnpm run lint:eslint --fix",
    "release:pack": "pnpm pack --dry-run"
  }
}
