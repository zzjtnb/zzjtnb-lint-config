{
  "name": "@zzjtnb/stylelint-config",
  "type": "module",
  "version": "1.0.3",
  "description": "Shareable Stylelint 17 config for CSS, SCSS, Vue SFC, UnoCSS, Tailwind-style workflows and uni-app.",
  "author": "zzjtnb(https://github.com/zzjtnb)",
  "license": "MIT",
  "homepage": "https://github.com/zzjtnb/zzjtnb-lint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzjtnb/zzjtnb-lint-config.git",
    "directory": "packages/stylelint-config"
  },
  "bugs": {
    "url": "https://github.com/zzjtnb/zzjtnb-lint-config/issues"
  },
  "keywords": [
    "stylelint",
    "stylelint-config",
    "shareable-config",
    "css",
    "scss",
    "vue",
    "unocss",
    "tailwindcss",
    "uni-app",
    "rpx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "format": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:patch": "pnpm version patch --no-git-tag-version --no-git-checks",
    "version:minor": "pnpm version minor --no-git-tag-version --no-git-checks",
    "version:major": "pnpm version major --no-git-tag-version --no-git-checks",
    "release:pack": "pnpm pack --dry-run",
    "release:publish": "pnpm publish --access public --tag latest --registry https://registry.npmjs.org/ --no-git-checks",
    "release:verify": "pnpm view @zzjtnb/stylelint-config version --registry https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "stylelint": "^17.12.0"
  },
  "dependencies": {
    "postcss": "catalog:",
    "postcss-html": "catalog:",
    "postcss-scss": "catalog:",
    "stylelint-config-recess-order": "catalog:",
    "stylelint-config-recommended-scss": "catalog:",
    "stylelint-config-recommended-vue": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-order": "catalog:"
  },
  "devDependencies": {
    "@zzjtnb/eslint-config": "workspace:*",
    "eslint": "catalog:"
  }
}
