{
  "name": "eslint-config-zzjtnb",
  "type": "module",
  "version": "0.0.9",
  "description": "Shareable ESLint 10 flat config built on top of @antfu/eslint-config for TypeScript, Vue, UnoCSS and HTML formatting workflows.",
  "author": "zzjtnb(https://github.com/zzjtnb)",
  "license": "MIT",
  "homepage": "https://github.com/zzjtnb/zzjtnb-lint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzjtnb/zzjtnb-lint-config.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/zzjtnb/zzjtnb-lint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "flat-config",
    "shareable-config",
    "antfu",
    "typescript",
    "vue",
    "unocss",
    "html"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "README.md",
    "README.zh-CN.md",
    "index.d.ts",
    "index.js"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node --check index.js",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "version:patch": "pnpm version patch --no-git-tag-version --no-git-checks",
    "version:minor": "pnpm version minor --no-git-tag-version --no-git-checks",
    "version:major": "pnpm version major --no-git-tag-version --no-git-checks",
    "release:pack": "pnpm pack --dry-run",
    "release:publish": "pnpm publish --access public --tag latest --registry https://registry.npmjs.org/ --no-git-checks",
    "release:verify": "pnpm view eslint-config-zzjtnb version --registry https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@unocss/eslint-plugin": "^66.6.8",
    "eslint-plugin-format": "^2.0.1"
  }
}
