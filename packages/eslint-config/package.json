{
  "name": "@zzjtnb/eslint-config",
  "type": "module",
  "version": "1.0.3",
  "description": "Shareable ESLint 10 flat config built on top of @antfu/eslint-config for TypeScript, Vue and pnpm workspaces.",
  "author": "zzjtnb(https://github.com/zzjtnb)",
  "license": "MIT",
  "homepage": "https://github.com/zzjtnb/zzjtnb-lint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzjtnb/zzjtnb-lint-config.git",
    "directory": "packages/eslint-config"
  },
  "bugs": {
    "url": "https://github.com/zzjtnb/zzjtnb-lint-config/issues"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "eslint-flat-config",
    "flat-config",
    "shareable-config",
    "antfu",
    "typescript",
    "vue",
    "unocss",
    "html"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "README.md",
    "README.zh-CN.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm exec tsdown",
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "format": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:patch": "pnpm version patch --no-git-tag-version --no-git-checks",
    "version:minor": "pnpm version minor --no-git-tag-version --no-git-checks",
    "version:major": "pnpm version major --no-git-tag-version --no-git-checks",
    "release:pack": "pnpm pack --dry-run",
    "release:publish": "pnpm publish --access public --tag latest --registry https://registry.npmjs.org/ --no-git-checks",
    "release:verify": "pnpm view @zzjtnb/eslint-config version --registry https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "eslint": "^10.4.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "catalog:"
  },
  "devDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
