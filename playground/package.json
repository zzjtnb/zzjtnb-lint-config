{
  "name": "@zzjtnb/playground",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "pnpm run generate && vite",
    "build": "pnpm run generate && run-p typecheck \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "generate": "pnpm --filter @zzjtnb/eslint-config run build && pnpm --filter @zzjtnb/stylelint-config run build && pnpm --filter @zzjtnb/markdownlint-config run build && jiti scripts/index.ts"
  },
  "dependencies": {
    "@webcontainer/api": "catalog:",
    "@xterm/addon-fit": "catalog:",
    "@xterm/xterm": "catalog:",
    "acorn": "catalog:",
    "echarts": "catalog:",
    "modern-monaco": "catalog:",
    "pinia": "catalog:",
    "reka-ui": "catalog:",
    "shiki": "catalog:",
    "vue": "catalog:",
    "vue-echarts": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@eslint/config-array": "catalog:",
    "@iconify-json/lucide": "catalog:",
    "@playwright/test": "catalog:",
    "@tsconfig/node24": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@zzjtnb/eslint-config": "workspace:*",
    "@zzjtnb/markdownlint-config": "workspace:*",
    "@zzjtnb/stylelint-config": "workspace:*",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "jsdom": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "sass-embedded": "catalog:",
    "stylelint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:typescript6",
    "unocss": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-vue-devtools": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
