{
  "name": "zzjtnb-lint-config",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --config eslint.config.ts --max-warnings 0",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.ts --cache --cache-location node_modules/.cache/.stylelintcache",
    "lint:markdownlint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"**/*.md\"",
    "format:eslint": "eslint . --fix --cache --cache-location node_modules/.cache/.eslintcache --config eslint.config.ts --max-warnings 0",
    "format:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.ts --fix --cache --cache-location node_modules/.cache/.stylelintcache",
    "format:markdownlint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc --fix \"**/*.md\"",
    "format": "pnpm run format:eslint && pnpm run format:stylelint && pnpm run format:markdownlint",
    "lint:workspaces:eslint": "turbo run lint:eslint --filter=!//",
    "lint:workspaces:stylelint": "turbo run lint:stylelint --filter=!//",
    "lint:workspaces:markdownlint": "turbo run lint:markdownlint --filter=!//",
    "lint:workspaces": "turbo run lint:eslint lint:stylelint lint:markdownlint --filter=!//",
    "lint": "turbo run //#lint:eslint //#lint:stylelint //#lint:markdownlint",
    "lint:tui": "turbo run //#lint:eslint //#lint:stylelint //#lint:markdownlint --ui=tui",
    "test": "turbo run test",
    "release": "node scripts/release.js",
    "typecheck": "turbo run typecheck",
    "version:patch": "turbo run version:patch --filter=@zzjtnb/stylelint-config --filter=@zzjtnb/eslint-config && pnpm install",
    "version:minor": "turbo run version:minor --filter=@zzjtnb/stylelint-config --filter=@zzjtnb/eslint-config && pnpm install",
    "version:major": "turbo run version:major --filter=@zzjtnb/stylelint-config --filter=@zzjtnb/eslint-config && pnpm install",
    "release:check": "turbo run build typecheck test lint:eslint lint:stylelint lint:markdownlint //#lint:eslint //#lint:stylelint //#lint:markdownlint",
    "release:pack": "turbo run release:pack --filter=@zzjtnb/stylelint-config --filter=@zzjtnb/eslint-config",
    "release:whoami": "pnpm whoami --registry https://registry.npmjs.org/",
    "release:publish": "turbo run release:publish --filter=@zzjtnb/stylelint-config --filter=@zzjtnb/eslint-config --concurrency=1",
    "release:verify": "turbo run release:verify --filter=@zzjtnb/stylelint-config --filter=@zzjtnb/eslint-config"
  },
  "devDependencies": {
    "@iconify/utils": "catalog:",
    "@types/node": "catalog:",
    "@unocss/preset-wind4": "catalog:",
    "@zzjtnb/eslint-config": "workspace:*",
    "@zzjtnb/stylelint-config": "workspace:*",
    "eslint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "stylelint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:"
  }
}
