{
  "name": "zzjtnb-lint-config",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "preinstall": "node ./scripts/preinstall.js",
    "postinstall": "pnpm -r run --if-present stub",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:root && turbo run typecheck",
    "clean": "node ./scripts/clean.js",
    "release": "node scripts/release/index.js",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --config eslint.config.ts --max-warnings 0",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.ts --cache --cache-location node_modules/.cache/.stylelintcache",
    "lint:markdownlint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc \"**/*.md\"",
    "lint": "turbo run //#lint:eslint //#lint:stylelint //#lint:markdownlint",
    "format:eslint": "pnpm run lint:eslint --fix",
    "format:stylelint": "pnpm run lint:stylelint --fix",
    "format:markdownlint": "pnpm run lint:markdownlint --fix",
    "format": "pnpm run format:eslint && pnpm run format:stylelint && pnpm run format:markdownlint",
    "lint:workspaces:eslint": "turbo run lint:eslint --filter=!//",
    "lint:workspaces:stylelint": "turbo run lint:stylelint --filter=!//",
    "lint:workspaces:markdownlint": "turbo run lint:markdownlint --filter=!//",
    "lint:workspaces": "turbo run lint:eslint lint:stylelint lint:markdownlint --filter=!//",
    "lint:tui": "turbo run //#lint:eslint //#lint:stylelint //#lint:markdownlint --ui=tui",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:packages": "vitest run --project packages"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@zzjtnb/eslint-config": "workspace:*",
    "@zzjtnb/stylelint-config": "workspace:*",
    "@zzjtnb/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "markdownlint-cli2": "catalog:",
    "stylelint": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
