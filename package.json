{
  "name": "zzjtnb-lint-config",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev --continue=dependencies-successful",
    "predev": "pnpm run ports",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "typecheck": "turbo run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present run test && pnpm --filter @zzjtnb/playground run test:unit --run",
    "bootstrap": "pnpm install",
    "preinstall": "node ./scripts/preinstall/index.js",
    "postinstall": "pnpm -r --filter './packages/**' --if-present run build",
    "release": "node scripts/release/index.js",
    "clean": "node ./scripts/clean/index.js",
    "ports": "node ./scripts/ports/index.js",
    "lint:eslint": "eslint . --cache --cache-location node_modules/.cache/.eslintcache --config eslint.config.js",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue,html}\" --config stylelint.config.js --cache --cache-location node_modules/.cache/.stylelintcache",
    "lint:markdownlint": "markdownlint-cli2 --config .markdownlint-cli2.mjs \"**/*.md\"",
    "lint": "turbo run //#lint:eslint //#lint:stylelint //#lint:markdownlint",
    "lint:tui": "turbo run //#lint:eslint //#lint:stylelint //#lint:markdownlint --ui=tui",
    "format:eslint": "pnpm run lint:eslint --fix",
    "format:stylelint": "pnpm run lint:stylelint --fix",
    "format:markdownlint": "pnpm run lint:markdownlint --fix",
    "format": "pnpm run format:eslint && pnpm run format:stylelint && pnpm run format:markdownlint"
  },
  "devDependencies": {
    "@zzjtnb/eslint-config": "workspace:*",
    "@zzjtnb/markdownlint-config": "workspace:*",
    "@zzjtnb/stylelint-config": "workspace:*",
    "eslint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "stylelint": "catalog:",
    "turbo": "catalog:"
  }
}
