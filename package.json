{
  "name": "zzjtnb-lint-config",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "eslint-inspect": "npx @eslint/config-inspector",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "clean": "rm -rf node_modules packages/*/dist packages/*/node_modules",
    "lint:eslint": "turbo run lint:eslint",
    "lint:stylelint": "turbo run lint:stylelint",
    "lint:markdownlint": "turbo run lint:markdownlint",
    "version:patch": "turbo run version:patch --filter=stylelint-config-zzjtnb --filter=eslint-config-zzjtnb && pnpm install",
    "version:minor": "turbo run version:minor --filter=stylelint-config-zzjtnb --filter=eslint-config-zzjtnb && pnpm install",
    "version:major": "turbo run version:major --filter=stylelint-config-zzjtnb --filter=eslint-config-zzjtnb && pnpm install",
    "release:check": "turbo run build check-types lint test",
    "release:pack": "turbo run release:pack --filter=stylelint-config-zzjtnb --filter=eslint-config-zzjtnb",
    "release:whoami": "pnpm whoami --registry https://registry.npmjs.org/",
    "release:publish": "turbo run release:publish --filter=stylelint-config-zzjtnb --filter=eslint-config-zzjtnb --concurrency=1",
    "release:verify": "turbo run release:verify --filter=stylelint-config-zzjtnb --filter=eslint-config-zzjtnb"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "eslint-config-zzjtnb": "workspace:*",
    "markdownlint-cli2": "^0.22.1",
    "stylelint": "^17.12.0",
    "stylelint-config-zzjtnb": "workspace:*",
    "turbo": "^2.9.14",
    "typescript": "6.0.3"
  }
}
